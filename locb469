local breakPCLDThread, breakPCLDCycleCount
local breakPCLDThread = nil
local breakPCLDCycleCount = 0
defenseGroup:AddToggle("BreakPCLD", {
    Text = "break PCLD (anti-kick)",
    Default = false,
    Callback = function(on)
        if breakPCLDThread then
            task.cancel(breakPCLDThread)
            breakPCLDThread = nil
        end
        if not on then
            breakPCLDCycleCount = 0
            return
        end
        breakPCLDThread = task.spawn(function()
            while true do
                breakPCLDCycleCount =
                    breakPCLDCycleCount + 1
                pcall(function()
                    local ch = LocalPlayer.Character
                    if ch then
                        local h =
                            ch:FindFirstChild(
                            "Humanoid")
                        if h and h.Health > 0 then
                            h.Health = 0
                        end
                    end
                end)
                task.wait(1)
            end
        end)
    end
})

local autoLeaveConnection = nil
defenseGroup:AddToggle("AutoLeave", {
    Text = "Auto Leave(anti-kick)",
    Default = false,
    Callback = function(on)
        if autoLeaveConnection then
            autoLeaveConnection:Disconnect()
            autoLeaveConnection = nil
        end
        if not on then return end
        local warnTimestamps = {}
        autoLeaveConnection =
            ReplicatedStorage.GameCorrectionEvents.
            GameCorrectionsNotify.OnClientEvent:
            Connect(function(message)
                if message == "Flying" then
                    local ct = os.clock()
                    table.insert(warnTimestamps, ct)
                    for i = #warnTimestamps, 1, -1 do
                        if ct - warnTimestamps[i]
                            > 1 then
                            table.remove(
                                warnTimestamps, i)
                        end
                    end
                    if #warnTimestamps >= 3 then
                        task.wait(0.5)
                        LocalPlayer:Kick("saved")
                    end
                end
            end)
    end
})

