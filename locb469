                    targetBG.Parent =
                        targetRoot

                    local highlight =
                        Instance.new(
                        "Highlight")
                    highlight.FillColor =
                        Color3.fromRGB(
                        255, 255, 255)
                    highlight.FillTransparency =
                        0.5
                    highlight.OutlineColor =
                        Color3.fromRGB(
                        255, 255, 255)
                    highlight.OutlineTransparency =
                        0
                    highlight.DepthMode =
                        Enum.HighlightDepthMode.
                        AlwaysOnTop
                    highlight.Adornee =
                        target.Character
                    highlight.Parent =
                        target.Character

                    if destroyGrabLine then
                        deleteThread =
                            task.spawn(
                            function()
                                while kickEnabled
                                    and target
                                    and target.
                                    Parent do
                                    local tC =
                                        target.
                                        Character
                                    local tR2 =
                                        tC and
                                        tC:
                                        FindFirstChild(
                                        "HumanoidRootPart")
                                    if not tR2
                                    then
                                        task.wait()
                                        continue
                                    end
                                    pcall(function()
                                        destroyGrabLine:
                                            FireServer(
                                            tR2)
                                    end)
                                    if
                                        kickDSLineDelay
                                        > 0 then
                                        task.wait(
                                            kickDSLineDelay)
                                    else
                                        task.wait()
                                    end
                                end
                            end)
                    end

                    local grabThread =
                        task.spawn(function()
                            while kickEnabled
                                and target
                                and target.Parent
                            do
                                local tC2 =
                                    target.
                                    Character
                                local tR3 =
                                    tC2 and
                                    tC2:
                                    FindFirstChild(
                                    "HumanoidRootPart")
                                local tH3 =
                                    tC2 and
                                    tC2:
                                    FindFirstChild(
                                    "Humanoid")
                                local mC2 =
                                    LocalPlayer.
                                    Character
                                local mR2 =
                                    mC2 and
                                    mC2:
                                    FindFirstChild(
                                    "HumanoidRootPart")
                                if tR3 and
                                    tH3 and
                                    tH3.Health
                                    > 0 and
                                    mR2 then
                                    local tp =
                                        mR2.Position
                                        + Vector3.
                                        new(
                                        kickOffsetX,
                                        math.
                                        min(
                                        kickHeight,
                                        20),
                                        kickOffsetZ)
                                    for _,
                                        part in
                                        pairs(
                                        tC2:
                                        GetChildren())
                                    do
                                        if
                                            part:IsA(
                                            "BasePart")
                                        then
                                            pcall(
                                                function()
                                                    setNetworkOwner:
                                                        FireServer(
                                                        part,
                                                        part.
                                                        CFrame)
                                                end)
                                        end
                                    end
                                    pcall(function()
                                        setNetworkOwner:
                                            FireServer(
                                            tR3,
                                            mR2.
                                            CFrame)
                                    end)
                                    if
                                        createGrabLine
                                    then
                                        pcall(
                                            function()
                                                createGrabLine:
                                                    FireServer(
                                                    tR3,
                                                    Vector3.
                                                    zero,
                                                    tp,
                                                    false)
                                            end)
                                    end
                                end
                                if
                                    useTickInterval
                                then
                                    task.wait(
                                        gInterval)
                                else
                                    task.wait()
                                end
                            end
                        end)

                    while kickEnabled
                        and target
                        and target.Parent
                    do
                        local tC =
                            target.Character
                        local tR2 =
                            tC and
                            tC:
                            FindFirstChild(
                            "HumanoidRootPart")
                        local tH2 =
                            tC and
                            tC:
                            FindFirstChild(
                            "Humanoid")
                        if not tR2 or
                            not tH2 or
                            tH2.Health
                            <= 0 then
                            break
                        end
                        myRoot =
                            LocalPlayer.
                            Character and
                            LocalPlayer.
                            Character:
                            FindFirstChild(
                            "HumanoidRootPart")
                        if not myRoot then
                            break
                        end
                        local dd =
                            (myRoot.
                            Position -
                            tR2.
                            Position).
                            Magnitude
                        if dd > 25 then
                            myRoot.CFrame =
                                tR2.CFrame *
                                CFrame.new(
                                0, 0, 2)
                            myRoot.Velocity =
                                Vector3.
                                zero
                        end
                        local targetPosition =
                            myRoot.
                            Position +
                            Vector3.new(
                            kickOffsetX,
                            math.min(
                            kickHeight,
                            20),
                            kickOffsetZ)
                        if
                            targetBP.Parent
                        then
                            targetBP.Position =
                                targetPosition
                        end
                        if
                            targetBG.Parent
                        then
                            targetBG.CFrame =
                                CFrame.new(
                                tR2.
                                Position)
                        end
                        tH2.Sit = false
                        tH2.PlatformStand =
                            true
                        tH2.AutoRotate =
                            false
                        tH2.WalkSpeed = 0
                        tH2.JumpPower = 0
                        while
                            #alignPositions
                            > alignCount
                        do
                            local a =
                                table.
                                remove(
                                alignPositions)
                            if a and
                                a.Parent
                            then
                                a:Destroy()
                            end
                        end
                        while
                            #alignOrientations
                            > alignCount
                        do
                            local o =
                                table.
                                remove(
                                alignOrientations)
                            if o and
                                o.Parent
                            then
                                o:Destroy()
                            end
                        end
                        for i = 1,
                            alignCount
                        do
                            if not
                                alignPositions[i]
                                or not
                                alignPositions[i].
                                Parent
                            then
                                if
                                    alignPositions[i]
                                then
                                    alignPositions[i]:
                                        Destroy()
                                end
                                local a =
                                    Instance.
                                    new(
                                    "AlignPosition")
                                a.Name =
                                    "KA_" ..
                                    i
                                a.Mode =
                                    Enum.
                                    PositionAlignmentMode.
                                    OneAttachment
                                a.MaxForce =
                                    1e13
                                a.MaxVelocity =
                                    200000
                                a.Responsiveness =
                                    20000
                                local at =
                                    Instance.
                                    new(
                                    "Attachment",
                                    tR2)
                                a.Attachment0 =
                                    at
                                a.Parent =
                                    tR2
                                alignPositions[i] =
                                    a
                                local o =
                                    Instance.
                                    new(
                                    "AlignOrientation")
                                o.Name =
                                    "KO_" ..
                                    i
                                o.Mode =
                                    Enum.
                                    OrientationAlignmentMode.
                                    OneAttachment
                                o.MaxTorque =
                                    1e13
                                o.MaxAngularVelocity =
                                    200000
                                o.Responsiveness =
                                    20000
                                local at2 =
                                    Instance.
                                    new(
                                    "Attachment",
                                    tR2)
                                o.Attachment0 =
                                    at2
                                o.Parent =
                                    tR2
                                alignOrientations[i] =
                                    o
                            end
                            alignPositions[i].
                                Position =
                                targetPosition
                            alignOrientations[i].
                                CFrame =
                                CFrame.new(
                                tR2.
                                Position)
                        end
                        task.wait()
                    end

                    if grabThread then
                        task.cancel(
                            grabThread)
                    end
                    if targetBP.Parent
                    then
                        targetBP:Destroy()
                    end
                    if targetBG.Parent
                    then
                        targetBG:Destroy()
                    end
                    if deleteThread then
                        task.cancel(
                            deleteThread)
                        deleteThread = nil
                    end
                    if highlight.Parent
                    then
                        highlight:Destroy()
                    end
                    for _, a in pairs(
                        alignPositions)
                    do
                        if a and
                            a.Parent
                        then
                            a:Destroy()
                        end
                    end
                    for _, o in pairs(
                        alignOrientations)
                    do
                        if o and
                            o.Parent
                        then
                            o:Destroy()
                        end
                    end
                    local endChar =
                        target.Character
                    if endChar then
                        local endHum =
                            endChar:
                            FindFirstChild(
                            "Humanoid")
                        if endHum then
                            endHum.PlatformStand =
                                false
                            endHum.AutoRotate =
                                true
                            endHum.WalkSpeed =
                                16
                            endHum.JumpPower =
                                50
                        end
                    end
                    task.wait()
                end
            end)
        end
    })
end
FastKick()

-- CLONE
local cloneActive = false
local cloneCharacter = nil
local cloneThread = nil

local function SpawnClone()
    if not cloneActive then return end
    local ch = LocalPlayer.Character
    if not ch then return end
    local root =
        ch:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local clone = ch:Clone()
    clone.Name =
        LocalPlayer.Name .. "_Clone"
    clone.Parent = Workspace

    for _, v in ipairs(
        clone:GetDescendants()) do
        if v:IsA("Script") or
            v:IsA("LocalScript") then
            v:Destroy()
        end
    end

    local newRoot =
        clone:FindFirstChild(
        "HumanoidRootPart")
    if newRoot then
        newRoot.CFrame =
            root.CFrame *
            CFrame.new(5, 0, 0)
        newRoot.Anchored = true
    end

    for _, v in ipairs(
        clone:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
            v.CanTouch = false
            v.CanQuery = false
            v.Transparency = 0.5
        end
    end

    cloneCharacter = clone
end

cloneGroup:AddToggle("CloneToggle", {
    Text = "Spawn Clone",
    Default = false,
    Callback = function(on)
        cloneActive = on
        if not on then
            if cloneCharacter and
                cloneCharacter.Parent
            then
                pcall(function()
                    local h =
                        cloneCharacter:
                        FindFirstChild(
                        "Humanoid")
                    if h then
                        h.Health = 0
                    end
                end)
            end
            cloneCharacter = nil
            if cloneThread then
                task.cancel(cloneThread)
                cloneThread = nil
            end
        else
            if cloneThread then
                task.cancel(cloneThread)
            end
            cloneThread =
                task.spawn(function()
                    while cloneActive do
                        task.wait(1)
                        if not
                            cloneCharacter
                            or not
                            cloneCharacter.
                            Parent then
                            SpawnClone()
                        end
                    end
                end)
        end
    end
})

cloneGroup:AddButton({
    Text = "Delete Clone",
    Func = function()
        if cloneCharacter and
            cloneCharacter.Parent
        then
            pcall(function()
                local h =
                    cloneCharacter:
                    FindFirstChild(
                    "Humanoid")
                if h then h.Health = 0 end
            end)
        end
        cloneCharacter = nil
    end
})

-- BOOMBOX
local BoomBoxGlobal = nil
local BoomBoxEnabled = false

local function UpdateBoomBox()
    local ch = LocalPlayer.Character
    if not ch then return end

    if BoomBoxEnabled then
        if BoomBoxGlobal and
            BoomBoxGlobal.Parent
        then
            return
        end
        local torso =
            ch:FindFirstChild("Torso")
            or ch:FindFirstChild(
            "UpperTorso")
        if torso then
            local box =
                Instance.new("Part")
            box.Name = "BoomBox"
            box.Size =
                Vector3.new(2, 2, 1)
            box.Color =
                Color3.fromRGB(255, 0, 0)
            box.Material =
                Enum.Material.Neon
            box.CFrame =
                torso.CFrame *
                CFrame.new(0, 0, -1)
            box.CanCollide = false
            box.Parent = Workspace

            local weld =
                Instance.new("Weld")
            weld.Part0 = torso
            weld.Part1 = box
            weld.C0 =
                CFrame.new(0, 0, -1)
            weld.Parent = box

            BoomBoxGlobal = box
        end
    else
        if BoomBoxGlobal then
            BoomBoxGlobal:Destroy()
            BoomBoxGlobal = nil
        end
    end
end

miscGroup:AddToggle("BoomBoxToggle", {
    Text = "BoomBox",
    Default = false,
    Callback = function(arg)
        BoomBoxEnabled = arg
        UpdateBoomBox()
    end
})

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if BoomBoxEnabled then
        BoomBoxGlobal = nil
        UpdateBoomBox()
    end
end)

