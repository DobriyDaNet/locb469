local lineLagCount = 10

lagGroup:AddSlider("LineLagCount", {
    Text = "Lines Count",
    Min = 1, Max = 100,
    Default = 10,
    Suffix = " lines",
    Callback = function(value)
        lineLagCount = value
    end
})

lagGroup:AddToggle("LineLag", {
    Text = "Line Lag",
    Default = false,
    Callback = function(on)
        if on then
            lineLagRunning = true
            local grabEvents =
                ReplicatedStorage:WaitForChild(
                "GrabEvents")
            if not grabEvents:FindFirstChild(
                "CreateGrabLine") then
                return
            end
            lineLagConnection =
                RunService.Heartbeat:Connect(
                function()
                    if not lineLagRunning then
                        return
                    end
                    if #lineLagLines > 500 then
                        for i = 1,
                            #lineLagLines - 500 do
                            local oldLine =
                                table.remove(
                                lineLagLines, 1)
                            if oldLine then
                                pcall(function()
                                    oldLine:Destroy()
                                end)
                            end
                        end
                    end
                    for i = 1, lineLagCount do
                        if not lineLagRunning then
                            break
                        end
                        pcall(function()
                            local line =
                                grabEvents.
                                CreateGrabLine:
                                FireServer(
                                Workspace.SpawnLocation,
                                CFrame.new(
                                    0, 9e9, 0),
                                false)
                            if line then
                                table.insert(
                                    lineLagLines,
                                    line)
                            end
                        end)
                    end
                end)
        else
            lineLagRunning = false
            if lineLagConnection then
                lineLagConnection:Disconnect()
                lineLagConnection = nil
            end
            for _, line in pairs(lineLagLines) do
                pcall(function()
                    if line and line.Parent then
                        line:Destroy()
                    end
                end)
            end
            lineLagLines = {}
        end
    end
})

defenseGroup:AddToggle("PacketDetector", {
    Text = "Packet Lag Detector",
    Default = false,
    Callback = function(value)
        _G.PacketDetectorActive = value
        if not value then return end
        task.spawn(function()
            local extendGrabLine =
                ReplicatedStorage:WaitForChild(
                "GrabEvents"):WaitForChild(
                "ExtendGrabLine")
            local logs = {}
            local connection = extendGrabLine.
                OnClientEvent:Connect(function(...)
                    if not _G.PacketDetectorActive
                    then
                        return
                    end
                    local totalChars = 0
                    local sender, displayName =
                        "Unknown", "Unknown"
                    for _, arg in ipairs({...}) do
                        local t = typeof(arg)
                        if t == "string" then
                            totalChars = totalChars +
                                #arg
                        elseif t == "Instance"
                            and arg:IsA("Player")
                        then
                            sender = arg.Name
                            displayName = arg.DisplayName
                        end
                    end
                    if totalChars < 10000 then
                        return
                    end
                    if not logs[sender]
                        or tick() - logs[sender] > 3
                    then
                        logs[sender] = tick()
                        pcall(function()
                            BetterOrion:MakeNotification({
                                Name =
                                    "Packet Detected",
                                Content = sender ..
                                    " (" ..
                                    displayName ..
                                    ")\n" ..
                                    string.format(
                                    "%.2f MB",
                                    totalChars /
                                    1048576),
                                Image = "activity",
                                Time = 5,
                                Color =
                                    Color3.fromRGB(
                                    45, 45, 45),
                                TextColor =
                                    Color3.fromRGB(
                                    255, 255, 255)
                            })
                        end)
                    end
                end)
            while _G.PacketDetectorActive do
                task.wait(1)
            end
            connection:Disconnect()
        end)
    end
})

-- CUSTOM
local CustomAssets = {
    Files = {},
    LoadedBackground = nil
}

local function LoadCustomAsset(url,
    prefix, ext)
    if type(url) ~= "string" or url == ""
    then
        return nil
    end
    if not (writefile and getcustomasset)
    then
        if url:match("^rbxassetid://")
            or url:match("^%d+$") then
            return "rbxassetid://" ..
                url:gsub("%D", "")
        end
        return url
    end
    local guid = HttpService:GenerateGUID(
        false):gsub("%-", "")
    local fileName = "custom_" ..
        (prefix or "asset") .. "_" ..
        guid .. (ext or "")
    local ok, result = pcall(function()
        return game:HttpGet(url, true)
    end)
    if not ok or type(result) ~= "string"
        or result == "" then
        return nil
    end
    if not pcall(writefile, fileName,
        result) then
        return nil
    end
    CustomAssets.Files[fileName] = fileName
    local ok2, asset = pcall(getcustomasset,
        fileName)
    if not ok2 or not asset then
        return nil
    end
    return asset
end

local function ApplyBackgroundImage(asset)
    pcall(function()
        Library:SetBackgroundImage(asset)
    end)
end

