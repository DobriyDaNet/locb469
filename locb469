defenseGroup:AddToggle("AntiKickAttach", {
    Text = "Anti Kick (Attach)",
    Default = false,
    Callback = function(value)
        _G.AntiKickAttachActive = value
        local function ClearAntiKickItems()
            local inventory = Workspace:FindFirstChild(
                LocalPlayer.Name .. "SpawnedInToys")
            local destroyRemote =
                ReplicatedStorage:FindFirstChild(
                "MenuToys")
            if destroyRemote then
                destroyRemote =
                    destroyRemote:FindFirstChild(
                    "DestroyToy")
            end
            if inventory and destroyRemote then
                for _, item in pairs(
                    inventory:GetChildren()) do
                    if item.Name == "AntiKick"
                        or item.Name == "NinjaShuriken"
                        or item.Name == "ToolPickaxe" then
                        pcall(function()
                            destroyRemote:FireServer(
                                item)
                        end)
                    end
                end
            end
        end
        if not value then
            _G.AntiKickAttachActive = false
            ClearAntiKickItems()
            return
        end
        task.spawn(function()
            local setNetworkOwner =
                ReplicatedStorage:WaitForChild(
                "GrabEvents"):WaitForChild(
                "SetNetworkOwner")
            local stickyPartEvent =
                ReplicatedStorage:WaitForChild(
                "PlayerEvents"):WaitForChild(
                "StickyPartEvent")
            local spawnRemote =
                ReplicatedStorage.MenuToys.
                SpawnToyRemoteFunction
            local function GetRootPart()
                if LocalPlayer.Character
                    and LocalPlayer.Character:
                    FindFirstChild(
                    "HumanoidRootPart") then
                    return LocalPlayer.Character.
                        HumanoidRootPart
                else
                    return LocalPlayer.
                        CharacterAdded:Wait():
                        WaitForChild(
                        "HumanoidRootPart")
                end
            end
            local function StickItem(item)
                if not item
                    or not item:FindFirstChild(
                    "StickyPart") then
                    return
                end
                local rootPart = GetRootPart()
                if not rootPart then return end
                if item:FindFirstChild("SoundPart") then
                    local owner =
                        item.SoundPart:FindFirstChild(
                        "PartOwner")
                    if not owner
                        or owner.Value ~=
                        LocalPlayer.Name then
                        setNetworkOwner:FireServer(
                            item.SoundPart,
                            item.SoundPart.CFrame)
                    end
                end
                local targetPart =
                    rootPart:FindFirstChild(
                    "FirePlayerPart")
                    or rootPart:WaitForChild(
                    "FirePlayerPart", 5)
                local attachCFrame =
                    CFrame.new(0, 0,
                    antiKickSelectedItem ==
                    "ToolPickaxe" and -1.5 or 0)
                    * CFrame.Angles(0,
                    math.rad(90),
                    math.rad(90))
                if targetPart then
                    stickyPartEvent:FireServer(
                        item.StickyPart,
                        targetPart,
                        attachCFrame)
                else
                    stickyPartEvent:FireServer(
                        item.StickyPart,
                        rootPart,
                        CFrame.new(0, 0, 0))
                end
            end
            while _G.AntiKickAttachActive do
                task.wait(0.5)
                if not LocalPlayer.Character
                    or not LocalPlayer.Character:
                    FindFirstChild("Humanoid")
                    or LocalPlayer.Character.
                    Humanoid.Health <= 0 then
                    continue
                end
                local inventory =
                    Workspace:FindFirstChild(
                    LocalPlayer.Name ..
                    "SpawnedInToys")
                local item = inventory and
                    inventory:FindFirstChild(
                    antiKickSelectedItem)
                if item and
                    item:FindFirstChild("StickyPart")
                then
                    StickItem(item)
                end
            end
        end)
    end
})

local function FreezeCharacter(character)
    local rootPart = character and
        character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    savedCFrame = rootPart.CFrame
    isFrozen = true
    if freezeConnection then
        freezeConnection:Disconnect()
    end
    freezeConnection =
        RunService.Heartbeat:Connect(function()
            if isFrozen and rootPart
                and rootPart.Parent then
                rootPart.AssemblyLinearVelocity =
                    Vector3.zero
                rootPart.AssemblyAngularVelocity =
                    Vector3.zero
                rootPart.CFrame = savedCFrame
            end
        end)
end

defenseGroup:AddToggle("AntiGrabObsidian", {
    Text = "Anti Grab",
    Default = false,
    Callback = function(value)
        local struggleRemote =
            ReplicatedStorage:FindFirstChild(
            "CharacterEvents") and
