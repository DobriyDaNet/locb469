local CANVAS_X = 1000

local History = {}
local Rows = {}
local MaxHistory = 200
local firstEvent = true
local waitingLabel = nil

local TEXT_SIZE = 13.7
local ROW_HEIGHT = 20
local WIDTH_SCALE = 1.20

local function UpdateCanvas()
    ContainerLeft.CanvasSize = UDim2.new(
        0, CANVAS_X, 0,
        ContainerLayout.AbsoluteContentSize.Y + 20)
end

local function RawAdd(text)
    local LabelFrame = Instance.new("Frame")
    LabelFrame.Name = "Label"
    LabelFrame.Parent = ContainerLeft
    LabelFrame.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
    LabelFrame.BackgroundTransparency = 1
    LabelFrame.BorderSizePixel = 0

    local Content = Instance.new("TextLabel",
        LabelFrame)
    Content.Name = "Content"
    Content.Size = UDim2.new(1, -10, 1, 0)
    Content.Position = UDim2.new(0, 5, 0, 0)
    Content.BackgroundTransparency = 1
    Content.Font = Enum.Font.GothamBlack
    Content.TextSize = TEXT_SIZE
    Content.TextXAlignment =
        Enum.TextXAlignment.Left
    Content.TextYAlignment =
        Enum.TextYAlignment.Center
    Content.TextColor3 = Color3.fromRGB(255, 255, 255)
    Content.TextTransparency = 0
    Content.RichText = true
    Content.Text = text
    Content.TextWrapped = false

    local scale = Instance.new("UIScale", Content)
    scale.Scale = WIDTH_SCALE

    table.insert(Rows, LabelFrame)
    table.insert(History, text)
    return LabelFrame
end

local function TrimHistory()
    while #History > MaxHistory do
        table.remove(History, 1)
        if Rows[1] then
            pcall(function() Rows[1]:Destroy() end)
            table.remove(Rows, 1)
        end
    end
end

local function AddRow(richText)
    if firstEvent and waitingLabel then
        pcall(function() waitingLabel:Destroy() end)
        for i, r in ipairs(Rows) do
            if r == waitingLabel then
                table.remove(Rows, i)
                table.remove(History, i)
                break
            end
        end
        waitingLabel = nil
        firstEvent = false
    end
    local lbl = RawAdd(richText)
    TrimHistory()
    UpdateCanvas()
    pcall(function()
        ContainerLeft.CanvasPosition = Vector2.new(
            0, math.max(0,
                ContainerLeft.AbsoluteCanvasSize.Y -
                ContainerLeft.AbsoluteWindowSize.Y))
    end)
    return lbl
end

local function AddSpacer()
    local Spacer = Instance.new("Frame")
    Spacer.Name = "Spacer"
    Spacer.Parent = ContainerLeft
    Spacer.Size = UDim2.new(1, 0, 0, 1)
    Spacer.BackgroundTransparency = 1
    Spacer.BorderSizePixel = 0
    table.insert(Rows, Spacer)
    table.insert(History, "")
    TrimHistory()
    UpdateCanvas()
end

local COLOR_LEFT = "rgb(24, 84, 133)"
local COLOR_JOINED = "rgb(16, 98, 34)"
local COLOR_KICKED = "rgb(191, 123, 18)"

local knownPlayers = {}
local currentPlayers = {}
local leftAt = {}
local REJOIN_WINDOW = 300
local SESSION_START = os.time()

for _, plr in ipairs(Players:GetPlayers()) do
    currentPlayers[plr.Name] = plr
    knownPlayers[plr.Name] = {
        DisplayName = plr.DisplayName,
        UserId = plr.UserId,
        JoinedAt = SESSION_START,
        LeftAt = nil,
    }
end

local function OnPlayerLeaving(player)
    if player == LocalPlayer then return end
    local now = os.time()
    local display = player.DisplayName
    local name = player.Name

    currentPlayers[name] = nil
    leftAt[name] = now

    if knownPlayers[name] then
        knownPlayers[name].LeftAt = now
    else
        knownPlayers[name] = {
            DisplayName = display,
            UserId = player.UserId,
            JoinedAt = nil,
            LeftAt = now,
        }
    end

    AddSpacer()
    local raw = string.format(
        "<font color='rgb(255,255,255)'>%s</font> "
        .. "<font color='%s'>left</font>",
        display, COLOR_LEFT)
    AddRow(raw)
end

local function OnPlayerJoining(player)
    if player == LocalPlayer then return end
    local display = player.DisplayName
    local name = player.Name
    local now = os.time()

    local prev = knownPlayers[name]
    local wasLeft = leftAt[name] ~= nil
    local withinWindow = wasLeft and
        (now - leftAt[name] <= REJOIN_WINDOW)

    currentPlayers[name] = player

    if prev and wasLeft and withinWindow then
        AddSpacer()
        local raw = string.format(
            "<font color='rgb(255,255,255)'>%s</font> "
            .. "<font color='%s'>rejoined</font>",
            display, COLOR_JOINED)
        AddRow(raw)
        leftAt[name] = nil
    end

    knownPlayers[name] = {
        DisplayName = display,
        UserId = player.UserId,
        JoinedAt = now,
        LeftAt = nil,
    }
end

local function OnBlackHoleObjectAdded(object)
    if object.Name ~= "BlackHoleKick"
        and object.Name ~= "BlackHoleDetected" then
        return
    end
    task.wait(0.05)
    if not object.Parent then return end

    local victim = nil
    local victimDisplay = "Unknown"

    local function findOwner(o)
        if not o then return nil end
        local p = o:FindFirstChild("PartOwner")
        if p and p:IsA("ObjectValue")
            and p.Value and p.Value:IsA("Player") then
            return p.Value
        end
        for _, ch in ipairs(o:GetDescendants()) do
            local p2 = ch:FindFirstChild("PartOwner")
            if p2 and p2:IsA("ObjectValue")
                and p2.Value
                and p2.Value:IsA("Player") then
                return p2.Value
            end
        end
        return nil
    end

    victim = findOwner(object)
    if victim then
        victimDisplay = victim.DisplayName
    else
        local pos
        if object:IsA("BasePart") then
            pos = object.Position
        elseif object:IsA("Model")
            and object.PrimaryPart then
            pos = object.PrimaryPart.Position
        end
        if pos then
            local closest, closestDist = nil, math.huge
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer
                    and plr.Character then
                    local root =
                        plr.Character:FindFirstChild(
                        "HumanoidRootPart")
                    if root then
                        local d =
                            (root.Position - pos).Magnitude
                        if d < closestDist then
                            closestDist = d
                            closest = plr
                        end
                    end
                end
            end
            if closest and closestDist < 30 then
                victim = closest
                victimDisplay = closest.DisplayName
            end
        end
    end

    AddSpacer()
    local raw = string.format(
        "<font color='rgb(255,255,255)'>%s</font> "
        .. "<font color='%s'>kicked</font>",
        victimDisplay, COLOR_KICKED)
    AddRow(raw)
end

local function SetupAntiCheatKickListener()
    local gce = ReplicatedStorage:FindFirstChild(
        "GameCorrectionEvents")
    if not gce then return end
    local notify = gce:FindFirstChild(
        "GameCorrectionsNotify")
    if not notify then return end

    notify.OnClientEvent:Connect(function(message)
        if message == "Flying" then
            AddSpacer()
            local raw = string.format(
                "<font color='rgb(255,255,255)'>%s</font> "
                .. "<font color='%s'>kicked (flying)</font>",
                LocalPlayer.DisplayName, COLOR_KICKED)
            AddRow(raw)
        end
    end)
end

